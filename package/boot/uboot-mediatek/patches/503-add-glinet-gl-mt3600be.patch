--- /dev/null
+++ b/board/mediatek/gl-mt3600be/gl-mt3600be.c
@@ -0,0 +1,43 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include <mtd.h>
+#include <linux/mtd/mtd.h>
+#include <nmbm/nmbm.h>
+#include <nmbm/nmbm-mtd.h>
+
+int board_nmbm_init(void)
+{
+	struct mtd_info *lower, *upper;
+	int ret;
+
+	mtd_probe_devices();
+	lower = get_mtd_device_nm("spi-nand0");
+	if (IS_ERR_OR_NULL(lower)) {
+		printf("Beryl7: NAND unavailable; use serial console\n");
+		return 0;
+	}
+	/* Refuse unexpected geometry rather than reinterpret the stock mapping. */
+	if (lower->size != 0x20000000ULL || lower->writesize != 4096 ||
+	    lower->erasesize != 0x40000 || lower->oobsize != 128) {
+		printf("Beryl7: unexpected NAND geometry; NMBM not attached\n");
+		put_mtd_device(lower);
+		return 0;
+	}
+	/* Never create or repair mapping tables in this development payload. */
+	ret = nmbm_attach_mtd(lower, NMBM_F_READ_ONLY |
+			      NMBM_F_EMPTY_PAGE_ECC_OK, 1, 256, &upper);
+	if (ret) {
+		printf("Beryl7: read-only NMBM attach failed: %d\n", ret);
+		put_mtd_device(lower);
+		return 0;
+	}
+	if (upper->size != 0x1e000000ULL) {
+		printf("Beryl7: unexpected NMBM size; not exposing mapping\n");
+		return 0;
+	}
+	/* UBI must also see read-only media, suppressing attach-time writes. */
+	upper->flags &= ~MTD_WRITEABLE;
+	ret = add_mtd_device(upper);
+	if (ret)
+		printf("Beryl7: cannot register NMBM: %d\n", ret);
+	return 0;
+}
