+	    !IS_ENABLED(CONFIG_ARMV8_SEC_FIRMWARE_SUPPORT)) {
+		err = fdt_kaslrseed(fdt, IS_ENABLED(CONFIG_KASLR_SEED_REQUIRED));
+		if (err && IS_ENABLED(CONFIG_KASLR_SEED_REQUIRED)) {
+			printf("ERROR: fresh KASLR seed unavailable (%d); refusing boot\n", err);
+			return err;
+		}
+	}
 
