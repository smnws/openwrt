+// SPDX-License-Identifier: (GPL-2.0 OR MIT)
+/dts-v1/;
+#include "mt7987a.dtsi"
+#include <dt-bindings/input/input.h>
+
+/ {
+	model = "GL.iNet GL-MT3600BE (development BL33)";
+	compatible = "mediatek,mt7987", "mediatek,mt7987-spim-nand-rfb";
+	/* OpenWrt patch 195 duplicates the SoC TRNG node. */
+	/delete-node/ rng;
+	memory { reg = <0 0x40000000 0 0x20000000>; };
+	chosen { stdout-path = "serial0:115200n8"; };
+	gpio-keys {
+		compatible = "gpio-keys";
+		reset {
+			label = "reset";
+			linux,code = <KEY_RESTART>;
+			gpios = <&pio 4 GPIO_ACTIVE_LOW>;
+		};
+	};
+};
--- /dev/null
+++ b/arch/arm/dts/mt7987a-glinet-gl-mt3600be-u-boot.dtsi
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0
+#include "mt7987a-u-boot.dtsi"
+
+/* BL2 initializes DRAM; tzcfg.c obtains the secure reservation from BL31. */
+&spi0 { status = "disabled"; };
+&spi1 { status = "disabled"; };
+&spi2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&spi2_flash_pins>;
+	#address-cells = <1>;
+	#size-cells = <0>;
+	status = "okay";
+	must_tx;
+	enhance_timing;
+	dma_ext;
+	ipm_design;
+	support_quad;
+	tick_dly = <2>;
+	sample_sel = <0>;
+	spi_nand@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <52000000>;
+		spi-rx-bus-width = <4>;
+		spi-tx-bus-width = <4>;
+	};
+};
+&trng { status = "okay"; };
+&pcie0 { status = "disabled"; };
+&pcie1 { status = "disabled"; };
+&xhci { status = "disabled"; };
