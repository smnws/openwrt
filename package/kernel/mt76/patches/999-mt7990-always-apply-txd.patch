Subject: [PATCH] wifi: mt76: mt7996: always supply and apply the host TX descriptor

Preserve the local policy of filling the host TX descriptor for every
frame and setting MT_CT_INFO_APPLY_TXD on the firmware TXP path.

Rebase onto mt76 0936617dc529, which combines the descriptor decision in
host_txd and also handles stream classification and explicit priority.
Remove that conditional decision so both operations remain unconditional;
keep the existing MAC TXP/AddBA path and other transmit handling intact.

--- a/mt7996/mac.c
+++ b/mt7996/mac.c
@@ -1057,7 +1057,6 @@
 	bool is_8023 = info->flags & IEEE80211_TX_CTL_HW_80211_ENCAP;
 	__le32 *ptr = (__le32 *)txwi_ptr;
 	u8 *txwi = (u8 *)txwi_ptr;
-	bool host_txd;
 	u8 link_id;
 
 	if (unlikely(tx_info->skb->len <= ETH_HLEN))
@@ -1142,18 +1141,11 @@
 
 	wcid = mt7996_get_tx_wcid(wcid);
 
-	/* mt76_tx_status_skb_add() clears info->control.flags */
-	host_txd = !is_8023 ||
-		   (info->control.flags & (IEEE80211_TX_CTRL_STREAM_CLASSIFIED |
-					   IEEE80211_TX_CTRL_EXPLICIT_UP));
-
 	pid = mt76_tx_status_skb_add(mdev, wcid, tx_info->skb);
 	memset(txwi_ptr, 0, MT_TXD_SIZE);
-	/* Transmit non qos data by 802.11 header and need to fill txd by host*/
-	host_txd |= pid >= MT_PACKET_ID_FIRST;
-	if (host_txd)
-		mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
-				      pid, qid, 0, link_id);
+	/* Always supply the host TX descriptor for firmware processing. */
+	mt7996_mac_write_txwi(dev, txwi_ptr, tx_info->skb, wcid, key,
+			      pid, qid, 0, link_id);
 
 	/* MT7996 and MT7992 require driver to provide the MAC TXP for AddBA
 	 * req
@@ -1203,8 +1195,8 @@
 
 		txp->fw.flags = cpu_to_le16(MT_CT_INFO_FROM_HOST);
 
-		if (host_txd)
-			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
+		/* Firmware must apply the host TX descriptor for every frame. */
+		txp->fw.flags |= cpu_to_le16(MT_CT_INFO_APPLY_TXD);
 
 		if (!key)
 			txp->fw.flags |= cpu_to_le16(MT_CT_INFO_NONE_CIPHER_FRAME);
